    }
  }

  entity: recent: {
    path: "/v1/recalls/recent": {
      op: list: method: *GET
    }
  }

  entity: submodel: {
    path: "/v1/vehicles/submodels": {
      op: list: method: *GET
    }
    path: "/v1/vehicles/trims": {
      op: list: method: *GET
    }
  }

  entity: vehicle: {
    path: "/v1/vehicles/years": {
      action: "year": {}
      op: list: method: *GET
    }
  }

  entity: vehicle_bulletin: {
