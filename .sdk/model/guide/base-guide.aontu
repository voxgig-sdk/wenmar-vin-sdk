# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 36
  metrics: count: path: 47
  metrics: count: method: 47

  entity: batch: {
    path: "/v1/vin/batch": {
      op: create: method: *POST
    }
  }

  entity: bulletin: {
    path: "/v1/bulletins": {
      op: list: method: *GET
    }
    path: "/v1/bulletins/{nhtsa_id}": {
      rename: param: "nhtsa_id": *"id"
      op: load: method: *GET
    }
  }

  entity: code: {
    path: "/v1/codes": {
      op: list: method: *GET
    }
    path: "/v1/codes/{code}": {
      rename: param: "code": *"id"
      op: load: method: *GET
    }
  }

  entity: data: {
    path: "/v1/meta": {
      op: load: method: *GET
    }
  }

  entity: engine: {
    path: "/v1/vehicles/engines": {
      op: list: method: *GET
    }
  }

  entity: entry: {
    path: "/v1/vehicles/search": {
      op: list: method: *GET
    }
    path: "/v1/vehicles/{id}": {
      op: load: method: *GET
    }
  }

  entity: job: {
    path: "/v1/jobs": {
      op: list: method: *GET
    }
