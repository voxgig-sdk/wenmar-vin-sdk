      rename: param: "id": *"vehicle_id"
      op: list: method: *GET
    }
    path: "/v1/vin/{vin}/overview": {
      rename: param: "vin": *"vin_id"
      op: list: method: *GET
    }
  }

  entity: parts_card: {
    path: "/v1/vin/{vin}/parts-card": {
      rename: param: "vin": *"vin_id"
      op: list: method: *GET
    }
  }

  entity: payroll_deduction: {
