  step: [
    {
      m: {
        vin: "vin01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "vin_spec_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVinSpecFlow"
}