# Entity: make

main: kit: entity: make: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The make's id form."
      t: "`$STRING`"
    }
    links: {
      h: "Links"
      n: "links"
      r: false
      t: "`$ANY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      t: "`$STRING`"
    }
    popular: {
      h: "Popular"
      n: "popular"
      r: true
      sh: "Whether it is on the list of popular makes."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "make"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/vehicles/makes"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "scope"
                or: "scope"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "term"
                or: "term"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 2019
                k: "query"
                n: "year"
                or: "year"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/v1/vehicles/makes"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "vehicles"
            }
            {
              lit: "makes"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/makes/{make}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "honda"
                k: "param"
                n: "id"
                or: "make"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/makes/{make}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              make: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "makes"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
