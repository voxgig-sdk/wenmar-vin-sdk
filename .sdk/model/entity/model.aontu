# Entity: model

main: kit: entity: model: {

  alias: field: {}

  fields: {
    as_of: {
      h: "As Of"
      n: "as_of"
      r: true
      sh: "The day each country's recall data was current."
      t: "`$OBJECT`"
    }
    attribution: {
      h: "Attribution"
      n: "attribution"
      r: true
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The model's id form."
      t: "`$STRING`"
    }
    lookup: {
      h: "Lookup"
      n: "lookup"
      r: true
      sh: "Where to check one vehicle for open recalls."
      t: "`$OBJECT`"
    }
    make: {
      h: "Make"
      n: "make"
      r: true
      sh: "A make or a model: its id form and its name."
      t: "`$OBJECT`"
    }
    may_apply: {
      h: "May Apply"
      n: "may_apply"
      r: true
      sh: "Always `true`: a recall count is of campaigns that may apply to the model year."
      t: "`$BOOLEAN`"
    }
    model: {
      h: "Model"
      n: "model"
      r: true
      sh: "A make or a model: its id form and its name."
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      t: "`$STRING`"
    }
    year_from: {
      fo: "int32"
      h: "Year From"
      n: "year_from"
      r: true
      sh: "The first and last model year the model exists in."
      t: "`$INTEGER`"
    }
    year_to: {
      fo: "int32"
      h: "Year To"
      n: "year_to"
      r: true
      t: "`$INTEGER`"
    }
    years: {
      h: "Years"
      n: "years"
      r: true
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    from: {
      make: "make.name"
      model: "model.name"
    }
    name: "id"
    parts: [
      "make"
      "model"
    ]
    sep: "/"
  }

  name: "model"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/vehicles/models"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "honda"
                k: "query"
                n: "make"
                or: "make"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "scope"
                or: "scope"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "term"
                or: "term"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 2019
                k: "query"
                n: "year"
                or: "year"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/v1/vehicles/models"
          q: {
            exist: [
              "make"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "vehicles"
            }
            {
              lit: "models"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/models/{make}/{model}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "ford"
                k: "param"
                n: "make"
                or: "make"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "f-150"
                k: "param"
                n: "model"
                or: "model"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/models/{make}/{model}"
          q: {
            exist: [
              "make"
              "model"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "models"
            }
            {
              var: "make"
            }
            {
              var: "model"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
