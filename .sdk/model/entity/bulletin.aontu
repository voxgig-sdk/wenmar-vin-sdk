                k: "query"
                n: "year"
                or: "year"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/v1/bulletins"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "bulletins"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/bulletins/{nhtsa_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "10152456"
                k: "param"
                n: "id"
                or: "nhtsa_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/bulletins/{nhtsa_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              nhtsa_id: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "bulletins"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
