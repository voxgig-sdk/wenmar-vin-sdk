  }

  name: "bulletin"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/bulletins"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "P0420"
                k: "query"
                n: "code"
                or: "code"
