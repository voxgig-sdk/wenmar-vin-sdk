                t: "`$STRING`"
              }
              {
                ex: "brakes"
                k: "query"
                n: "component"
                or: "component"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "cursor"
                or: "cursor"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "limit"
