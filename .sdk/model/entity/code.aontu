      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "code"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/codes"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "cursor"
                or: "cursor"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "P04"
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "powertrain/emissions"
                k: "query"
                n: "system"
                or: "system"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/codes"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "codes"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/codes/{code}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "P0420"
                k: "param"
                n: "id"
                or: "code"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/codes/{code}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              code: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "codes"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
